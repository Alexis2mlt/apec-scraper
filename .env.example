# Aucune clé API : l'endpoint APEC utilisé est public et non authentifié.
# Ces variables ne pilotent que le comportement du scraper.

APEC_MIN_DELAY=0.8
APEC_MAX_DELAY=2.0
APEC_MAX_RETRIES=4
APEC_TIMEOUT=25
APEC_OUTPUT_DIR=./data
# Seuil d'alerte qualité : % max de champs vides toléré avant warning
APEC_EMPTY_FIELD_THRESHOLD=20
